PORT=5000
NODE_ENV=development

# PostgreSQL (via Docker)
DATABASE_URL=postgresql://civicconnect:civicconnect_pass@localhost:5432/civicconnect

# JWT
JWT_SECRET=civicconnect_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# OTP (Twilio — replace with real credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Email (SendGrid — replace with real credentials)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@civicconnect.in

# Frontend CORS
FRONTEND_URL=http://localhost:3000
